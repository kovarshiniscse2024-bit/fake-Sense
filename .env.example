# =========================================================================
# FakeSense - Environment Configuration
# =========================================================================

# Secret key for JWT access tokens
FAKESENSE_SECRET_KEY=fakesense-super-secret-production-key-928374928374

# =========================================================================
# Real Email (SMTP) Configuration
# To receive OTP codes in your actual Gmail inbox, configure below:
# =========================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

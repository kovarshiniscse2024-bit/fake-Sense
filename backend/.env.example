# ==============================================================================
# FakeSense Backend Environment Configuration
# ==============================================================================

# Database Configuration (Optional, defaults to local SQLite)
# DATABASE_URL=sqlite:///./fakesense.db

# JWT Secret Key
# SECRET_KEY=your-super-secret-jwt-key

# ==============================================================================
# SMTP Email Configuration (For Real Password Reset & Verification Emails)
# ==============================================================================
# For Gmail:
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for 'FakeSense' (generates a 16-character password)
# 4. Fill in the values below:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Set DEV_MODE=true only if you want offline test codes returned when no SMTP is configured
DEV_MODE=false
